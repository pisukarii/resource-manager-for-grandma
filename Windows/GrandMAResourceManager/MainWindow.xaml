<Window x:Class="GrandMAResourceManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:GrandMAResourceManager.Models"
        Title="Resource Manager for grandMA"
        Width="1080" Height="680" MinWidth="820" MinHeight="480"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource AppForegroundBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <ContextMenu x:Key="SourceRowContextMenu">
            <MenuItem Header="名前を変更..." Click="OnRenameSourceClick" />
            <MenuItem Header="接続設定を編集..." Click="OnEditSftpSourceClick" />
            <MenuItem Header="削除" Click="OnRemoveSourceClick" />
        </ContextMenu>

        <ContextMenu x:Key="FileRowContextMenu">
            <MenuItem Header="開く" Click="OnOpenMenuClick" />
            <MenuItem Header="Finderで表示..." Click="OnRevealMenuClick" />
            <Separator />
            <MenuItem Header="名前を変更..." Click="OnRenameMenuClick" />
            <MenuItem Header="削除..." Click="OnDeleteMenuClick" />
        </ContextMenu>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource AppForegroundBrush}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Top toolbar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SidebarBackgroundBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1">
            <Grid Margin="10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Resource Manager for grandMA" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnQuickOpenClick" ToolTip="すべてのSourceを横断してファイル名で検索 (Ctrl+K)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE721;" Margin="0,0,4,0" />
                            <TextBlock Text="Quick Open" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- USB detection banner -->
        <Border DockPanel.Dock="Top" Background="#2A3A2A" Padding="10,6"
                Visibility="{Binding UsbWatcher.PendingDetection, Converter={StaticResource NullToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center">
                    <Run Text="{Binding UsbWatcher.PendingDetection.Family, Mode=OneWay, Converter={StaticResource ConsoleFamilyDisplay}}" />
                    <Run Text=" USBメモリ「" />
                    <Run Text="{Binding UsbWatcher.PendingDetection.DriveRoot, Mode=OneWay}" />
                    <Run Text="」を検出しました" />
                </TextBlock>
                <Button Grid.Column="1" Content="Sourceとして追加" Click="OnAddDetectedUsbClick" Margin="0,0,8,0" Padding="10,4" />
                <Button Grid.Column="2" Content="無視" Click="OnDismissUsbBannerClick" Padding="10,4" />
            </Grid>
        </Border>

        <!-- Error banners -->
        <StackPanel DockPanel.Dock="Top">
            <Border Background="#402A1E1E" Padding="10,6" Visibility="{Binding ConnectionError, Converter={StaticResource NullToVis}}">
                <TextBlock Text="{Binding ConnectionError, StringFormat=接続エラー: {0}}" Foreground="#FF8A80" TextWrapping="Wrap" />
            </Border>
            <Border Background="#402A1E1E" Padding="10,6" Visibility="{Binding ImportError, Converter={StaticResource NullToVis}}">
                <TextBlock Text="{Binding ImportError, StringFormat=インポートエラー: {0}}" Foreground="#FF8A80" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <!-- Transfer progress bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource SidebarBackgroundBrush}" Padding="12,8"
                Visibility="{Binding IsTransferring, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="{Binding TransferLabel}" FontSize="11" Margin="0,0,0,4" TextTrimming="CharacterEllipsis" />
                <ProgressBar IsIndeterminate="True" Height="4" />
            </StackPanel>
        </Border>

        <!-- Main content -->
        <Grid>
            <!-- First-run welcome -->
            <StackPanel Visibility="{Binding HasNoSources, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                <TextBlock Text="&#xE8B7;" Style="{StaticResource IconTextStyle}" FontSize="48" HorizontalAlignment="Center" Foreground="{StaticResource SecondaryForegroundBrush}" Margin="0,0,0,16" />
                <TextBlock Text="Resource Manager for grandMA へようこそ" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,8" />
                <TextBlock Text="grandMA3 / grandMA2 のファイルにすばやくアクセスするための Source を追加してください。"
                           Foreground="{StaticResource SecondaryForegroundBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16" />
                <Button Content="Sourceを追加..." Click="OnAddSourceClick" HorizontalAlignment="Center" Padding="16,8" />
            </StackPanel>

            <!-- Sidebar / Category / FileList -->
            <Grid Visibility="{Binding HasNoSources, Converter={StaticResource InverseBoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar: Sources -->
                <DockPanel Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}">
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1" Padding="10,6">
                        <Grid>
                            <TextBlock Text="Sources" Foreground="{StaticResource SecondaryForegroundBrush}" FontSize="11" VerticalAlignment="Center" />
                            <Button Style="{StaticResource ToolbarButtonStyle}" HorizontalAlignment="Right" Click="OnAddSourceClick" ToolTip="Sourceを追加">
                                <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE710;" />
                            </Button>
                        </Grid>
                    </Border>
                    <ListBox x:Name="SourcesListBox"
                             ItemsSource="{Binding Store.Configs}"
                             SelectedItem="{Binding SelectedSourceConfig, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0"
                             AllowDrop="True" Drop="OnSourceRowDrop" DragOver="OnSourceRowDragOver">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="10,6" />
                                <Setter Property="ContextMenu" Value="{StaticResource SourceRowContextMenu}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:SourceConfig}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconTextStyle}" Text="{Binding KindGlyph}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="0,0,6,0" TextTrimming="CharacterEllipsis" />
                                    <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"
                                             Visibility="{Binding IsSftp, Converter={StaticResource BoolToVis}}"
                                             Fill="{Binding SftpConnected, Converter={StaticResource SftpConnectedBrush}}"
                                             ToolTip="SFTP接続状態" />
                                    <Border Background="#33808080" CornerRadius="8" Padding="5,1" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding FamilyBadge}" FontSize="10" FontWeight="SemiBold" />
                                    </Border>
                                    <Border Background="#33FFB03B" CornerRadius="8" Padding="5,1"
                                            Visibility="{Binding ShowMaNetBadge, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding MaNetLabel}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <Rectangle Grid.Column="1" Fill="{StaticResource BorderBrush2}" />

                <!-- Category shortcuts -->
                <ListBox Grid.Column="2"
                         ItemsSource="{Binding CurrentCategories}"
                         SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                         Background="{StaticResource SidebarBackgroundBrush}" BorderThickness="0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="10,5" />
                            <Setter Property="AllowDrop" Value="True" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:ConsoleCategory}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconTextStyle}" Text="{Binding SymbolGlyph}" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Rectangle Grid.Column="3" Fill="{StaticResource BorderBrush2}" />

                <!-- File list -->
                <DockPanel Grid.Column="4">
                    <!-- Breadcrumb + search + selection bar -->
                    <StackPanel DockPanel.Dock="Top">
                        <Grid Margin="10,8" Visibility="{Binding SelectedCategory, Converter={StaticResource NullToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding BreadcrumbText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="1" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding ToggleSelectionModeCommand}" Margin="0,0,4,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE73E;" Margin="0,0,4,0" />
                                    <TextBlock Text="選択" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding RefreshCommand}">
                                <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE72C;" />
                            </Button>
                        </Grid>
                        <Border Height="1" Background="{StaticResource BorderBrush2}" />
                        <Grid Margin="10,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" Foreground="{StaticResource AppForegroundBrush}"
                                     Tag="このフォルダ内を検索" />
                            <ComboBox Grid.Column="1" Width="180" Margin="8,0,0,0"
                                      Visibility="{Binding AvailableManufacturers.Count, Converter={StaticResource NonZeroCountToVis}}"
                                      ItemsSource="{Binding AvailableManufacturers}"
                                      SelectedItem="{Binding SelectedManufacturer, Mode=TwoWay}" />
                            <ComboBox x:Name="JumpSubfolderComboBox" Grid.Column="2" Width="160" Margin="8,0,0,0"
                                      Visibility="{Binding JumpableSubfolders.Count, Converter={StaticResource NonZeroCountToVis}}"
                                      ItemsSource="{Binding JumpableSubfolders}"
                                      DisplayMemberPath="Name"
                                      Text="サブフォルダへ移動"
                                      IsEditable="True" IsReadOnly="True"
                                      SelectionChanged="OnJumpSubfolderSelectionChanged" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource BorderBrush2}" />
                        <Grid Margin="10,6" Visibility="{Binding IsSelectionMode, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding SelectedEntries.Count, StringFormat={}{0}件を選択中}" Foreground="{StaticResource SecondaryForegroundBrush}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="すべて選択" Style="{StaticResource ToolbarButtonStyle}" Click="OnSelectAllClick" Margin="0,0,8,0" />
                            <Button Grid.Column="2" Style="{StaticResource ToolbarButtonStyle}" Click="OnBulkDeleteClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE74D;" Foreground="#FF6B6B" Margin="0,0,4,0" />
                                    <TextBlock Text="削除..." Foreground="#FF6B6B" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <Grid AllowDrop="True" Drop="OnFileListDrop" DragOver="OnFileListDragOver">
                        <TextBlock Text="左のカテゴリを選択してください" Foreground="{StaticResource SecondaryForegroundBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding SelectedCategory, Converter={StaticResource InverseNullToVis}}" />

                        <TextBlock Text="ファイルがありません" Foreground="{StaticResource SecondaryForegroundBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding SelectedCategory, Converter={StaticResource NullToVis}}" Value="Visible" />
                                                <Condition Binding="{Binding FilteredEntries.Count}" Value="0" />
                                                <Condition Binding="{Binding IsLoading}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ListView x:Name="FileListView"
                                  ItemsSource="{Binding FilteredEntries}"
                                  Visibility="{Binding SelectedCategory, Converter={StaticResource NullToVis}}"
                                  Background="Transparent" BorderThickness="0"
                                  SelectionMode="Extended"
                                  SelectionChanged="OnFileListSelectionChanged"
                                  MouseDoubleClick="OnFileListDoubleClick"
                                  AllowDrop="True"
                                  PreviewMouseLeftButtonDown="OnFileListPreviewMouseDown"
                                  MouseMove="OnFileListMouseMove">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                    <Setter Property="ContextMenu" Value="{StaticResource FileRowContextMenu}" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="名前" Width="380">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type models:FileEntry}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource IconTextStyle}"
                                                               Text="{Binding IsDirectory, Converter={StaticResource FileEntryGlyph}}"
                                                               Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="サイズ" Width="100" DisplayMemberBinding="{Binding Size, Converter={StaticResource FileSize}}" />
                                    <GridViewColumn Header="更新日時" Width="160" DisplayMemberBinding="{Binding ModifiedDate}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>

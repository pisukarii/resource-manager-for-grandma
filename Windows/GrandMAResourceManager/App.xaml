<Application x:Class="GrandMAResourceManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GrandMAResourceManager.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Views/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
            <conv:NullToVisibilityConverter x:Key="NullToVis" />
            <conv:InverseNullToVisibilityConverter x:Key="InverseNullToVis" />
            <conv:ZeroCountToVisibilityConverter x:Key="ZeroCountToVis" />
            <conv:NonZeroCountToVisibilityConverter x:Key="NonZeroCountToVis" />
            <conv:FileSizeConverter x:Key="FileSize" />
            <conv:FileEntryGlyphConverter x:Key="FileEntryGlyph" />
            <conv:ConsoleFamilyDisplayConverter x:Key="ConsoleFamilyDisplay" />
            <conv:SftpConnectedBrushConverter x:Key="SftpConnectedBrush" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

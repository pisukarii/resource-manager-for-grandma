<Window x:Class="GrandMAResourceManager.AddSourceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sourceを追加"
        Width="480" Height="420" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource AppForegroundBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Sourceを追加" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

        <TabControl x:Name="KindTabControl" Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="ローカル (onPC)">
                <StackPanel Margin="0,10">
                    <TextBlock x:Name="LocalEmptyText" Text="onPC のインストールが見つかりませんでした。" Foreground="{StaticResource SecondaryForegroundBrush}" Margin="0,0,0,8" />
                    <ListBox x:Name="LocalListBox" MaxHeight="160" Background="Transparent" BorderThickness="0" MouseDoubleClick="OnLocalItemDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding FamilyDisplay}" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Name}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="追加" Click="OnLocalAddClick" Tag="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Separator Margin="0,10" />
                    <TextBlock Text="自動検出されない場合は手動で選択してください:" FontSize="11" Foreground="{StaticResource SecondaryForegroundBrush}" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton x:Name="LocalMa3Radio" Content="grandMA3" IsChecked="True" GroupName="LocalFamily" Margin="0,0,16,0" />
                        <RadioButton x:Name="LocalMa2Radio" Content="grandMA2" GroupName="LocalFamily" />
                    </StackPanel>
                    <Button Content="フォルダを手動で選択..." HorizontalAlignment="Left" Click="OnPickLocalFolderClick" />
                </StackPanel>
            </TabItem>

            <TabItem Header="USBメモリ">
                <StackPanel Margin="0,10">
                    <TextBlock x:Name="UsbEmptyText" Text="grandMA3 / grandMA2 のUSBメモリが見つかりませんでした。" Foreground="{StaticResource SecondaryForegroundBrush}" Margin="0,0,0,8" />
                    <ListBox x:Name="UsbListBox" MaxHeight="160" Background="Transparent" BorderThickness="0" MouseDoubleClick="OnUsbItemDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding FamilyDisplay}" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding DriveRoot}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="追加" Click="OnUsbAddClick" Tag="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Separator Margin="0,10" />
                    <TextBlock Text="自動検出されない場合は手動で選択してください:" FontSize="11" Foreground="{StaticResource SecondaryForegroundBrush}" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton x:Name="UsbMa3Radio" Content="grandMA3" IsChecked="True" GroupName="UsbFamily" Margin="0,0,16,0" />
                        <RadioButton x:Name="UsbMa2Radio" Content="grandMA2" GroupName="UsbFamily" />
                    </StackPanel>
                    <Button Content="ドライブを手動で選択..." HorizontalAlignment="Left" Click="OnPickUsbFolderClick" />
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="キャンセル" Click="OnCancelClick" Padding="12,4" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
